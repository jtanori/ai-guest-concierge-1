# ─────────────────────────────────────────────────────────────────────────────
#  .env — start here
# ─────────────────────────────────────────────────────────────────────────────
#
#  LOCAL, 2 minutes, no accounts:
#      cp .env.example .env
#      npm run check:readiness -- --env local --file .env
#
#  STAGING and PRODUCTION, one file each:
#      cp .env.example .env.staging          # then set APP_ENV=staging
#      npm run check:readiness -- --env staging --file .env.staging
#      npm run secrets:sync -- --env=staging --env-file=.env.staging --dry-run
#
#  WHERE EACH VALUE COMES FROM, click by click: docs/env-setup.md
#
#  ONE NAME IN EVERY ENVIRONMENT. Staging's database goes into DATABASE_URL
#  inside .env.staging — never STAGING_DATABASE_URL. The deploy selects the
#  value by which GitHub Environment it runs in, not by the name.
#
#  Every .env* file is gitignored. Nothing here is committed.

# ── identity ─────────────────────────────────────────────────────────────────
# local | staging | prod. Must match the file name; a mismatch is refused.
# The host injects this at runtime in a real deploy.
APP_ENV=local
# Only needed to tell two deployments apart in one log sink.
APP_NAME=ai-guest-concierge
# debug | info | warn | error — defaults to debug locally, info elsewhere.
LOG_LEVEL=debug

# ── database ─────────────────────────────────────────────────────────────────
# console.neon.tech > project > Connect. Turn Connection pooling OFF and copy
# the direct string: migrations run with this same URL, and the pooler is not
# built for them. One URL per environment.
DATABASE_URL=postgres://concierge:concierge@localhost:54329/concierge_local

# ── staff sign-in (Neon Auth) ────────────────────────────────────────────────
# console.neon.tech > project > Auth > copy the Auth URL.
#   JWKS   = <Auth URL>/.well-known/jwks.json
#   ISSUER = leave empty first; it falls back to the Auth URL. If a real token
#            is rejected with "issuer mismatch", paste that token's `iss` here.
# NEON_AUTH_BASE_URL=https://<endpoint>.neonauth.<region>.aws.neon.tech/<db>/auth
# NEON_AUTH_JWKS_URL=
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=

# ── the public guest chat ────────────────────────────────────────────────────
# openssl rand -base64 32        (32 characters minimum; signs the guest cookie)
# GUEST_COOKIE_SECRET=
# The origin a printed QR code points at. Bare, no path, no trailing slash.
# GUEST_PUBLIC_URL=https://chat.example.com

# ── the model that writes replies ────────────────────────────────────────────
# aistudio.google.com/apikey > Create API key   (starts with AIza)
# Model ids are pinned by hand and must not be a -latest alias; the loader
# refuses one at boot. Current ids: ai.google.dev/gemini-api/docs/models
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_TIMEOUT_MS=8000
# LLM_RETRIES=2

# ── retrieval (embeddings) ───────────────────────────────────────────────────
# platform.openai.com/api-keys. text-embedding-3-small emits the 1536
# dimensions the schema locks; another model fails before it reaches Postgres.
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TIMEOUT_MS=20000
# EMBEDDING_BATCH_SIZE=16

# ── bot check on the first guest message ─────────────────────────────────────
# dash.cloudflare.com > Turnstile > Add widget. The secret and the site key are
# TWO different keys from the SAME widget. Staging may use Cloudflare's
# always-pass test pair: secret 1x0000000000000000000000000000000AA,
# site key 1x00000000000000000000AA.
# TURNSTILE_SECRET=
# TURNSTILE_TIMEOUT_MS=3000
# The site key is public and belongs to the web tier, so it lives in Vercel:
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── escalation email (Resend) ────────────────────────────────────────────────
# resend.com/api-keys > Create API key > Sending access. Then verify a domain at
# resend.com/domains. Until a domain is verified only onboarding@resend.dev
# works, and only to the address on your Resend account — fine for a staging
# smoke test, never for production.
# One address; a display name is allowed here.
EMAIL_FROM=Concierge <desk@example.com>
# EMAIL_API_KEY=
# Where a request goes when the property configured no email contact.
# Bare address only — no display name.
# EMAIL_ESCALATION_FALLBACK=oncall@example.com
# Absolute base of the staff console; the link in every escalation email.
# CONSOLE_BASE_URL=https://console.example.com

# ── staff console → API ──────────────────────────────────────────────────────
# The origin the Next server calls. Never the browser. Once deployed this is the
# same value as API_URL below.
REVIEW_API_URL=http://127.0.0.1:8787

# ── deploy plumbing (CI only; the app never reads these) ─────────────────────
# vercel.com/account/settings/tokens for the token;
# project > Settings > General for the project id; team > Settings > General for
# the team id. secrets:sync puts these at REPO level, once, for every environment.
# VERCEL_TOKEN=
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=
# What `smoke` probes after a deploy. Per environment, same name.
# API_URL=https://api.example.com

# ── rarely touched ───────────────────────────────────────────────────────────
# none | once | always — turns an AI outage into an input. Refused when
# APP_ENV=prod, because a host that one copied file can break is an outage.
# AI_FAIL_MODE=
# Staging only: let a preview host boot with gaps instead of refusing.
# Refused outright when APP_ENV=prod.
# ALLOW_DEGRADED_BOOT=
# W00-14 has no reporter yet. Set it when error tracking lands.
# SENTRY_DSN=

# ── platform plumbing (src/server.ts; declared so the contract sees them) ─────
# Bind address and port. The hosting convention supplies these; both default
# (127.0.0.1:3000), so no environment requires them yet.
# HOST=127.0.0.1
# PORT=3000
# Which property `npm run smoke` scores against. Defaults to demo.
# SMOKE_PROPERTY_SLUG=demo

# ── asset storage and the Neon function probe (read at their own routes) ──────
# The S3-compatible pair: /healthz/storage and the asset routes refuse to run
# without it. Not required by any stage yet — no environment runs src/server.ts
# until a host is chosen (issue #153).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_ENDPOINT_URL_S3=
# The Neon Function that /healthz/function probes.
# NEON_FUNCTION_HELLO_BASE_URL=
