# W00-13 — template. Copy per machine; real .env files are gitignored.
# `npm run check:env` validates the deployment matrix before anything boots.

APP_ENV=local

# One database per environment. Local values default in compose.yml.
DATABASE_URL=postgres://concierge:concierge@localhost:54329/concierge_local

# The Phase B deployment matrix (checked, never assumed):
# STAGING_DATABASE_URL=postgres://...neon-or-supabase-staging...
# PROD_DATABASE_URL=postgres://...neon-or-supabase-prod...

LOG_LEVEL=debug
SENTRY_DSN=

APP_NAME=ai-guest-concierge

# S02-01 — Neon Auth (managed Better Auth) JWT verification. The base URL is
# also the default issuer/audience; override explicitly if the branch's tokens
# carry different values. JWKS is the branch endpoint probed in W00.
# NEON_AUTH_BASE_URL=https://<branch>.neonauth.<region>.aws.neon.tech/<db>/auth
# NEON_AUTH_JWKS_URL=https://<branch>.neonauth.<region>.aws.neon.tech/<db>/auth/.well-known/jwks.json
# NEON_AUTH_ISSUER=
# NEON_AUTH_AUDIENCE=


# S04-01 — the staff review screen (web/) is a Next.js app that consumes the
# JSON surface above through one proxy route. It runs as its own npm project:
#   npm run web:install && npm run web:dev      # or web:build
# REVIEW_API_URL is the ONLY address the screen calls, and only from the
# Next server (never from the browser): the staff token stays in an HttpOnly
# cookie and the proxy attaches it.
REVIEW_API_URL=http://127.0.0.1:8787

# S04-02 / DEC-3 — embedding provider for chunking and publishing.
# DEC-3 (operator, 2026-10-25): OpenAI `text-embedding-3-small` over plain
# `fetch`; no SDK. The model must emit 1536 dimensions (D3 locks the column);
# anything else fails in assertEmbeddingDimension before it reaches Postgres.
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_TIMEOUT_MS=20000
# EMBEDDING_BATCH_SIZE=16

# --- S05-01 / DEC-2: LLM (Google Gemini) -----------------------------------
# Both model ids are REQUIRED and must be pinned: a `-latest` alias is refused
# by loadLlmConfig, because the same alias is a different model in six months.
# Recommended pair: gemini-2.5-flash (primary) / gemini-2.5-flash-lite (fallback).
# LLM_API_KEY is required outside APP_ENV=local; CI uses a stub provider.
# LLM_PRIMARY_MODEL=gemini-2.5-flash
# LLM_FALLBACK_MODEL=gemini-2.5-flash-lite
# LLM_API_KEY=AIza...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_TIMEOUT_MS=8000

# S06-01 — the public guest chat signs its anonymous identity cookie with this.
# Required (>= 32 chars) wherever /c/:slug is served: a default would be a
# published signing key, so an unset value makes the guest routes answer 503
# with a reason instead of handing out forgeable cookies.
# GUEST_COOKIE_SECRET=<openssl rand -base64 32>


# --- S07-04: abuse + cost protection ---------------------------------------
# Two unrelated controls that both exist because /c/:slug is public.
#
# 1. Rate limits are NOT configurable here. They are constants in
#    src/security/ratelimit.ts (20/min per hashed IP, 10/min per conversation,
#    600/hour per property). A ceiling a property can raise is not a ceiling.
#
# 2. The bot check (Cloudflare Turnstile, or any vendor behind the port in
#    src/security/botcheck.ts). TURNSTILE_SECRET is required outside
#    APP_ENV=local: a host that serves real guests must not run without the
#    control it was configured to use.
#    W00-18 / DEC-9: enabling this sends guest IPs and browser metadata to a
#    third-party processor, so it must appear in the privacy notice and be
#    covered by a DPA BEFORE production. Until then, staging runs with it.
# TURNSTILE_SECRET=<from the Cloudflare dashboard>
# TURNSTILE_TIMEOUT_MS=3000
#
# The site key is public by design and is read by the browser bundle (web/),
# not by the API. Absent ⇒ no widget renders and the server is not enforcing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=<from the Cloudflare dashboard>
