{
  "name": "ai-guest-concierge",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant AI guest concierge for hotels (no PMS integration). See docs/01-development-plan.md.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:env": "node scripts/check-env.ts",
    "db:migrate": "node --experimental-strip-types scripts/migrate.ts",
    "db:seed": "node --experimental-strip-types scripts/seed.ts",
    "embed:all": "node --experimental-strip-types scripts/embed-all.ts",
    "db:test": "vitest run --config tests/db/vitest.db.config.ts",
    "smoke:neon": "node --env-file=.env.local scripts/smoke-neon.ts",
    "start": "node --env-file=.env.local src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "web:install": "npm --prefix web install",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "exceljs": "^4.4.0",
    "globals": "^15.15.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@neon/config": "^1.9.3",
    "@neon/env": "^1.6.4",
    "pg": "^8.23.1",
    "pino": "^9.14.0"
  }
}
