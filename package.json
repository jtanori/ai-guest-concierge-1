{
  "name": "ai-guest-concierge",
  "version": "0.0.0",
  "private": true,
  "description": "Multi-tenant AI guest concierge for hotels (no PMS integration). See docs/01-development-plan.md.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:env": "node scripts/check-env.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.5",
    "exceljs": "^4.4.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "pino": "^9.14.0"
  }
}
