{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/healthz/postgres",
      "dest": "/api/healthz/postgres"
    },
    {
      "src": "/healthz",
      "dest": "/api/healthz"
    },
    {
      "src": "/api/health.ts",
      "dest": "/api/health"
    },
    {
      "src": "/api/review/(.*)",
      "dest": "/api/review/[...path]",
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/api/review/$1"
        }
      ]
    },
    {
      "handle": "filesystem"
    }
  ]
}
